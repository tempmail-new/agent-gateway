# Copy this file to docs/deployment/container-example/.env.local and edit local values.
# The deployment helper scripts source that file before running Docker Compose.

# Remap the host port while keeping the container on PORT=8080.
DEPLOYMENT_EXAMPLE_GATEWAY_PORT=18081

# Point Docker Compose secrets at operator-owned local files.
# Create these files before running deployment-preflight or deployment-smoke.
DEPLOYMENT_EXAMPLE_GATEWAY_API_KEYS_FILE=./docs/deployment/container-example/secrets/gateway-api-keys.local
DEPLOYMENT_EXAMPLE_OPENAI_API_KEY_FILE=./docs/deployment/container-example/secrets/openai-api-key.local

# If you change gateway-api-keys.local, keep this token aligned with one of
# that file's comma-separated API keys so deployment-request and smoke auth pass.
AGENT_GATEWAY_DEPLOYMENT_EXAMPLE_TOKEN=deploy-example-token
