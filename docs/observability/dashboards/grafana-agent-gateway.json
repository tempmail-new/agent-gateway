{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "target": {
          "limit": 100,
          "matchAny": false,
          "tags": [],
          "type": "dashboard"
        },
        "type": "dashboard"
      }
    ]
  },
  "description": "Starter Agent Gateway dashboard for OTLP metrics exported through the OpenTelemetry Collector Prometheus exporter.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "targets": [
        {
          "expr": "sum(rate(agent_gateway_http_server_requests_total[$__rate_interval])) by (http_route, http_response_status_code)",
          "legendFormat": "{{http_route}} {{http_response_status_code}}",
          "refId": "A"
        }
      ],
      "title": "HTTP Request Rate",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "id": 2,
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(agent_gateway_http_server_duration_milliseconds_bucket[$__rate_interval])) by (le, http_route))",
          "legendFormat": "p95 {{http_route}}",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.50, sum(rate(agent_gateway_http_server_duration_milliseconds_bucket[$__rate_interval])) by (le, http_route))",
          "legendFormat": "p50 {{http_route}}",
          "refId": "B"
        }
      ],
      "title": "HTTP Latency",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "cps"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 7
      },
      "id": 3,
      "targets": [
        {
          "expr": "sum(rate(agent_gateway_provider_calls_total[$__rate_interval])) by (agent_gateway_provider_name, agent_gateway_provider_outcome)",
          "legendFormat": "{{agent_gateway_provider_name}} {{agent_gateway_provider_outcome}}",
          "refId": "A"
        }
      ],
      "title": "Provider Call Rate",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "cps"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 7
      },
      "id": 4,
      "targets": [
        {
          "expr": "sum(rate(agent_gateway_provider_calls_total{agent_gateway_provider_outcome=\"error\"}[$__rate_interval])) by (agent_gateway_provider_name, agent_gateway_provider_error_code)",
          "legendFormat": "{{agent_gateway_provider_name}} {{agent_gateway_provider_error_code}}",
          "refId": "A"
        }
      ],
      "title": "Provider Errors",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "max": 1,
          "min": 0,
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 14
      },
      "id": 6,
      "targets": [
        {
          "expr": "sum(increase(agent_gateway_http_server_requests_total{http_response_status_code=~\"5..\"}[$__range])) / clamp_min(sum(increase(agent_gateway_http_server_requests_total[$__range])), 1)",
          "legendFormat": "5xx ratio",
          "refId": "A"
        },
        {
          "expr": "sum(increase(agent_gateway_http_server_requests_total{http_response_status_code=~\"4..\"}[$__range])) / clamp_min(sum(increase(agent_gateway_http_server_requests_total[$__range])), 1)",
          "legendFormat": "4xx ratio",
          "refId": "B"
        }
      ],
      "title": "HTTP Error Ratio",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "max": 1,
          "min": 0,
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 14
      },
      "id": 7,
      "targets": [
        {
          "expr": "sum(increase(agent_gateway_provider_calls_total{agent_gateway_provider_outcome=\"error\"}[$__range])) / clamp_min(sum(increase(agent_gateway_provider_calls_total[$__range])), 1)",
          "legendFormat": "provider error ratio",
          "refId": "A"
        }
      ],
      "title": "Provider Error Ratio",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 7,
        "w": 24,
        "x": 0,
        "y": 21
      },
      "id": 5,
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(agent_gateway_provider_duration_milliseconds_bucket[$__rate_interval])) by (le, agent_gateway_provider_name))",
          "legendFormat": "p95 {{agent_gateway_provider_name}}",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.50, sum(rate(agent_gateway_provider_duration_milliseconds_bucket[$__rate_interval])) by (le, agent_gateway_provider_name))",
          "legendFormat": "p50 {{agent_gateway_provider_name}}",
          "refId": "B"
        }
      ],
      "title": "Provider Latency",
      "type": "timeseries"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["agent-gateway", "opentelemetry"],
  "templating": {
    "list": [
      {
        "current": {},
        "hide": 0,
        "includeAll": false,
        "label": "Prometheus",
        "multi": false,
        "name": "DS_PROMETHEUS",
        "options": [],
        "query": "prometheus",
        "refresh": 1,
        "regex": "",
        "type": "datasource"
      }
    ]
  },
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timezone": "browser",
